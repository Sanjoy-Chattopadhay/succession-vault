="lifecycle-6" value='&lt;b&gt;Settled&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#334155"&gt;payout started&lt;/span&gt;' style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.4;fontFamily=Arial;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="508" y="192" width="120" height="46" as="geometry"/></mxCell><mxCell id="lifecycle-7" value='createVault&lt;br&gt;&lt;span style="font-size:11px;color:#334155"&gt;&lt;i&gt;t&lt;/i&gt;&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;h&lt;/span&gt; = &lt;i&gt;t&lt;/i&gt;&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;ℓ&lt;/span&gt; = now&lt;/span&gt;' style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0F172A;strokeWidth=1.3;fontFamily=Arial;fontSize=12.5;fontColor=#0F172A;labelBackgroundColor=none;rounded=1;verticalAlign=top;" edge="1" parent="1" source="lifecycle-2" target="lifecycle-3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="lifecycle-8" value="&lt;i&gt;t&lt;/i&gt; &amp;gt; &lt;i&gt;D&lt;/i&gt;" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0F172A;strokeWidth=1.3;fontFamily=Arial;fontSize=12.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;rounded=1;verticalAlign=bottom;" edge="1" parent="1" source="lifecycle-3" target="lifecycle-4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lifecycle-9" value='&lt;i&gt;t&lt;/i&gt; &amp;gt; &lt;i&gt;D&lt;/i&gt; + Δ&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;g&lt;/span&gt;' style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0F172A;strokeWidth=1.3;fontFamily=Arial;fontSize=12.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;rounded=1;verticalAlign=bottom;" edge="1" parent="1" source="lifecycle-4" target="lifecycle-5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lifecycle-10" value="first claim&lt;br&gt;or sweep" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#0F172A;strokeWidth=1.3;fontFamily=Arial;fontSize=12.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;rounded=1;verticalAlign=middle;align=right;spacingRight=8;" edge="1" parent="1" source="lifecycle-5" target="lifecycle-6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-6" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="lifecycle-11" value='proveLife, or heartbeat while &lt;i&gt;t&lt;/i&gt;&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;ℓ&lt;/span&gt; + Δ&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;ℓ&lt;/span&gt; &amp;gt; now' style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1E6F6A;strokeWidth=1.3;fontFamily=Arial;fontSize=12.5;fontColor=#1E6F6A;labelBackgroundColor=#FFFFFF;rounded=1;verticalAlign=bottom;dashed=1;dashPattern=5 3;curved=1;exitX=0.3;exitY=0;entryX=0.72;entryY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="lifecycle-4" target="lifecycle-3"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="62"/><mxPoint x="154" y="62"/></Array></mxGeometry></mxCell><mxCell id="lifecycle-12" value="the same revival, possible until the first claim" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1E6F6A;strokeWidth=1.3;fontFamily=Arial;fontSize=12.5;fontColor=#1E6F6A;labelBackgroundColor=#FFFFFF;rounded=1;verticalAlign=bottom;dashed=1;dashPattern=5 3;curved=1;exitX=0.35;exitY=0;entryX=0.25;entryY=0;" edge="1" parent="1" source="lifecycle-5" target="lifecycle-3"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="538" y="20"/><mxPoint x="64" y="20"/></Array></mxGeometry></mxCell><mxCell id="lifecycle-13" value='more claims;&lt;br&gt;sweep after &lt;i&gt;D&lt;/i&gt; + Δ&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;g&lt;/span&gt; + Δ&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;c&lt;/span&gt;' style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#475569;strokeWidth=1.3;fontFamily=Arial;fontSize=12.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;rounded=1;verticalAlign=middle;curved=1;align=right;exitX=0;exitY=0.3;entryX=0;entryY=0.75;spacingRight=4;" edge="1" parent="1" source="lifecycle-6" target="lifecycle-6"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="482" y="201.8"/><mxPoint x="482" y="230.5"/></Array><mxPoint x="-4" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="lifecycle-14" value='&lt;i&gt;D&lt;/i&gt; = min(&lt;i&gt;t&lt;/i&gt;&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;h&lt;/span&gt; + Δ&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;h&lt;/span&gt;, &lt;i&gt;t&lt;/i&gt;&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;ℓ&lt;/span&gt; + Δ&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;ℓ&lt;/span&gt;)&lt;br&gt;&lt;span style="font-size:11px;color:#334155"&gt;the status is a function of (&lt;i&gt;t&lt;/i&gt;&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;h&lt;/span&gt;, &lt;i&gt;t&lt;/i&gt;&lt;span style="font-size:75%;vertical-align:-0.28em;line-height:0"&gt;ℓ&lt;/span&gt;, now),&lt;br&gt;so no keeper transaction is ever needed&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Arial;fontSize=13;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="8" y="190" width="250" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
